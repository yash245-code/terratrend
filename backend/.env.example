# TeraTrend Environment Configuration

# NASA Earthdata Login Credentials (free account from https://urs.earthdata.nasa.gov/)
EARTHDATA_USERNAME=your_nasa_earthdata_username
EARTHDATA_PASSWORD=your_nasa_earthdata_password

# Flask Web Server Settings
SECRET_KEY=teratrend-nasa-space-apps-super-secret-key-2026
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# Pipeline Configuration
DOWNLOAD_BACKEND=auto
# Choices: auto, harmony, earthaccess, opendap

# Optional External API Services
ENABLE_SOILGRIDS_LIVE=false
GEOCODER_USER_AGENT=TeraTrend-App/1.0 (contact@teratrend.org)
DATA_GOV_IN_API_KEY=your_datagov_in_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///data/teratrend.db
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/teratrend
AUTO_CREATE_DB=false
ADMIN_TOKEN=

# Cache Settings
CACHE_ENABLED=true
CACHE_MAX_ROWS=100000
REQUEST_LOGGING=false

# Saved Items
ENABLE_SAVED_ITEMS=true
SAVED_LOCATION_LIMIT=50
SAVED_SCENARIO_LIMIT=100
COOKIE_SECURE=false

# Versioning & Features
CODE_VERSION=1.0.0
ENABLE_GRID_PRECOMPUTE=false
